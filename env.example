# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AI Image Generation
IMAGE_MODEL_PROVIDER=openai
OPENAI_API_KEY=
NANO_BANANA_API_KEY=

# Video Generation
VIDEO_PROVIDER=sora

# Google Identity
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Custom Auth
AUTH_JWT_SECRET=
DISABLE_AUTH=false

# Dev
# In non-production NODE_ENV, plan limits are bypassed automatically.
