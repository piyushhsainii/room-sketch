# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Image Generation
IMAGE_MODEL_PROVIDER=openai
OPENAI_API_KEY=
NANO_BANANA_API_KEY=

# Video Generation
VIDEO_PROVIDER=sora

# Google Identity
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Custom Auth
AUTH_JWT_SECRET=
DISABLE_AUTH=false

# Dev
# In non-production NODE_ENV, plan limits are bypassed automatically.

# Optional: OpenAI-provisioned Sign in with ChatGPT identity client.
# Register this exact callback URL with OpenAI.
CHATGPT_CLIENT_ID=
CHATGPT_REDIRECT_URI=http://localhost:3000/api/chatgpt/callback
# Set for a confidential client provisioned with client_secret_basic.
CHATGPT_CLIENT_SECRET=
# Account linking also requires the server-only AUTH_JWT_SECRET above.
# RoomSketch MCP (apply supabase/migrations/202611190002_mcp.sql first)
MCP_ENABLED=false
# Optional additional browser origins allowed to call /api/mcp, comma separated.
# Native clients normally omit Origin. Token management remains same-origin only.
MCP_ALLOWED_ORIGINS=
